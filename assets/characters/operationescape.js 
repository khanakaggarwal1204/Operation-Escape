// ---- UI: background, title, per-character name/description (fixed
//      text, alpha toggled like the dialogue system), instructions, and
//      clickable left/right arrow buttons.
//
//  draw_char_select_background() is deliberately its OWN function,
//  separate from draw_char_select_ui(), and is called from the
//  assembly section BEFORE the characters are created. This engine
//  layers objects in creation order (later-created draws on top of
//  earlier-created), so the opaque full-screen backdrop must exist
//  first, otherwise it paints over every character and hides them
//  entirely. draw_char_select_ui() (title/instructions/name/desc
//  text/arrows) is still called AFTER the characters, so that UI
//  correctly stays on top of them.
// ----------------------------------------------------------------
let char_name_texts = [];
let char_desc_texts = [];
let char_left_arrow = null;
let char_right_arrow = null;

function draw_char_select_background(list) {
    make_rect(list, SCREEN_WIDTH / 2, SCREEN_HEIGHT / 2, SCREEN_WIDTH, SCREEN_HEIGHT, 12, 10, 16, 255);
    return undefined;
}

function draw_char_select_ui(list) {
    make_text(list, SCREEN_WIDTH / 2, 55, "CHOOSE YOUR DETECTIVE", 1.3, 230, 195, 90, 255);
    make_text(list, SCREEN_WIDTH / 2, 565, "\u2190 / \u2192 to browse  -  ENTER to select  -  ESC to go back", 0.55, 200, 195, 180, 220);

    for (let i = 0; i < array_length(characters); i = i + 1) {
        const record = characters[i];
        char_name_texts[i] = make_text(list, SCREEN_WIDTH / 2, 470, record[CH_NAME], 1.1, 235, 225, 200, 0);
        char_desc_texts[i] = make_text(list, SCREEN_WIDTH / 2, 505, record[CH_DESC], 0.65, 210, 205, 220, 0);
    }

    char_left_arrow = make_triangle(list, 90, CHAR_PREVIEW_Y, 40, 60, 220, 200, 140, 255);
    update_rotation(char_left_arrow, -math_PI / 2);
    char_right_arrow = make_triangle(list, SCREEN_WIDTH - 90, CHAR_PREVIEW_Y, 40, 60, 220, 200, 140, 255);
    update_rotation(char_right_arrow, math_PI / 2);

    return undefined;
}

function set_all_parts_alpha(all_parts, alpha) {
    for (let i = 0; i < array_length(all_parts); i = i + 1) {
        const p = all_parts[i];
        // For sprites, we use update_color to control alpha
        // The color values stored are just placeholders
        update_color(p[0], [p[1], p[2], p[3], alpha]);
    }
    return undefined;
}

// Re-applies which single character is visible. Called right after
// this scene becomes active (undoes show_scene()'s uniform alpha
// restore) and again every time the browsed index changes.
function sync_char_select_visuals() {
    for (let i = 0; i < array_length(characters); i = i + 1) {
        const on = i === char_select_index;
        set_all_parts_alpha(characters[i][CH_ALL_PARTS], on ? 255 : 0);
        update_color(char_name_texts[i], [235, 225, 200, on ? 255 : 0]);
        update_color(char_desc_texts[i], [210, 205, 220, on ? 255 : 0]);
    }
    return undefined;
}

function next_character() {
    char_select_index = (char_select_index + 1) % array_length(characters);
    sync_char_select_visuals();
    return undefined;
}

function previous_character() {
    char_select_index = (char_select_index + array_length(characters) - 1) % array_length(characters);
    sync_char_select_visuals();
    return undefined;
}

// select_character() - confirms the browsed character as the pick
// for the rest of the session, applies it to the Room 1 avatar, and
// starts the smooth fade into the hallway.
function select_character() {
    selected_character_index = char_select_index;
    spawn_selected_character();
    start_char_select_fade();
    return undefined;
}

let char_left_prev = false;
let char_right_prev = false;

function update_char_select_input(confirmed, clicked) {
    const left_down = input_key_down("ArrowLeft");
    const right_down = input_key_down("ArrowRight");

    if (left_down && !char_left_prev) { previous_character(); }
    if (right_down && !char_right_prev) { next_character(); }
    char_left_prev = left_down;
    char_right_prev = right_down;

    if (clicked) {
        if (pointer_over_gameobject(char_left_arrow)) { previous_character(); }
        if (pointer_over_gameobject(char_right_arrow)) { next_character(); }
    }

    if (confirmed) {
        select_character();
    }

    return undefined;
}

function animate_char_select_arrows(t) {
    const pulse_l = 1 + 0.08 * math_sin(t * 3);
    const pulse_r = 1 + 0.08 * math_sin(t * 3 + math_PI);
    update_scale(char_left_arrow, [pulse_l, pulse_l]);
    update_scale(char_right_arrow, [pulse_r, pulse_r]);
    return undefined;
}

// ----------------------------------------------------------------
//  animate_character() - shared animation routine for sprite-based
//  characters: idle breathing, blinking via scale.
//  Uses the same uniform scale (0.6) for all characters.
// ----------------------------------------------------------------
function animate_character(record, t, loop_count) {
    const sprite = record[CH_SPRITE];
    if (sprite === null || sprite === undefined) {
        return undefined;
    }
    
    // Idle breathing / bobbing motion
    const breathe = 1 + 0.025 * math_sin(t * 1.6);
    const bobY = 4 * math_sin(t * 1.6);
    update_position(sprite, [CHAR_PREVIEW_X, CHAR_PREVIEW_Y + bobY]);
    update_scale(sprite, [0.6 * breathe, 0.6 * breathe]); // Uniform scale 0.6
    
    // Blinking effect: quickly scale the sprite's y
    const period_frames = 4 * FPS;
    const blink_frames = math_round(0.12 * FPS);
    const cycle_pos = loop_count % period_frames;
    const blink_scale_y = (cycle_pos < blink_frames) ? 0.1 : 1;
    update_scale(sprite, [0.6 * breathe, 0.6 * breathe * blink_scale_y]); // Uniform scale 0.6
    
    return undefined;
}

// ----------------------------------------------------------------
//  Smooth fade transition from Character Selection into the hallway.
//  Same "fade rect not registered to any scene" trick used by the
//  Room 1 door fade, kept independent from it since it spans a
//  different pair of scenes.
// ----------------------------------------------------------------
let char_select_fade_rect = null;
let char_select_fade_state = "none"; // "none" | "out" | "in"
let char_select_fade_timer = 0;
const CHAR_SELECT_FADE_FRAMES = math_round(0.5 * FPS);

function start_char_select_fade() {
    char_select_fade_state = "out";
    char_select_fade_timer = 0;
    return undefined;
}

function update_char_select_fade() {
    if (char_select_fade_state === "out") {
        char_select_fade_timer = char_select_fade_timer + 1;
        const p = math_min(1, char_select_fade_timer / CHAR_SELECT_FADE_FRAMES);
        update_color(char_select_fade_rect, [0, 0, 0, 255 * p]);
        if (p >= 1) {
            change_scene("room_select");
            sync_room_select_visuals(hallway_doors);
            char_select_fade_state = "in";
            char_select_fade_timer = 0;
        }
    } else if (char_select_fade_state === "in") {
        char_select_fade_timer = char_select_fade_timer + 1;
        const p = math_min(1, char_select_fade_timer / CHAR_SELECT_FADE_FRAMES);
        update_color(char_select_fade_rect, [0, 0, 0, 255 * (1 - p)]);
        if (p >= 1) {
            char_select_fade_state = "none";
        }
    }
    return undefined;
}

// ----------------------------------------------------------------
//  Applying the chosen character to the Room 1 avatar. The engine
//  has no sprite-swap, so the same procedurally-built player circle
//  set is recolored to match the chosen character's coat/hat, and
//  a small signature-accessory glow (lantern/cross/torch/mystery/
//  scanner) follows the player around, so the choice is visibly
//  carried into every future room.
// ----------------------------------------------------------------
const CHAR_BODY_COLORS = [[92, 60, 33], [32, 30, 42], [150, 120, 70], [12, 11, 15], [180, 180, 190]];
const CHAR_HAT_COLORS = [[55, 36, 20], [20, 18, 28], [130, 100, 55], [6, 5, 9], [255, 200, 50]];
const CHAR_ACCESSORY_COLORS = [[255, 200, 100], [180, 200, 255], [255, 170, 60], [150, 80, 190], [0, 200, 255]];

let room1_character_accessory_objs = []; // one small signature-accessory glow per character

// draw_room1_character_accessories() - pre-makes every signature
// accessory glow near the Room 1 player, alpha 0 until the matching
// character is selected (see spawn_selected_character()).
function draw_room1_character_accessories(list) {
    for (let i = 0; i < array_length(CHAR_ACCESSORY_COLORS); i = i + 1) {
        const c = CHAR_ACCESSORY_COLORS[i];
        room1_character_accessory_objs[i] = make_circle(list, room1_player_x + 20, room1_player_y + 5, 8, c[0], c[1], c[2], 0);
    }
    return undefined;
}

// spawn_selected_character() - recolors the existing Room 1 player
// avatar (body/hat) to match the chosen character, and reveals that
// character's signature accessory glow while hiding the others.
function spawn_selected_character() {
    const idx = selected_character_index;
    const body_col = CHAR_BODY_COLORS[idx];
    const hat_col = CHAR_HAT_COLORS[idx];

    update_color(room1_player_parts[0][0], [body_col[0], body_col[1], body_col[2], 255]);
    update_color(room1_player_parts[2][0], [hat_col[0], hat_col[1], hat_col[2], 255]);

    for (let i = 0; i < array_length(room1_character_accessory_objs); i = i + 1) {
        update_color(room1_character_accessory_objs[i], [0, 0, 0, 0]);
    }
    const c = CHAR_ACCESSORY_COLORS[idx];
    update_color(room1_character_accessory_objs[idx], [c[0], c[1], c[2], 220]);

    return undefined;
}

// Keeps the signature accessory glow glued to the player's position
// every frame (called from the Room 1 branch of the main loop).
function update_character_accessory_position(offset_x, offset_y) {
    for (let i = 0; i < array_length(room1_character_accessory_objs); i = i + 1) {
        update_position(room1_character_accessory_objs[i], [room1_player_x + offset_x, room1_player_y + offset_y]);
    }
    return undefined;
}

// Small idle glow pulse on whichever accessory is currently visible.
function animate_character_accessory(t) {
    const obj = room1_character_accessory_objs[selected_character_index];
    const pulse = 1 + 0.15 * math_sin(t * 3);
    update_scale(obj, [pulse, pulse]);
    return undefined;
}

// ================================================================
//  SCENE 2: ROOM SELECT (mysterious hallway, 4 doors)
// ================================================================

// Simple corridor: floor + back wall + tapered side wall strips to
// suggest a hallway receding into the distance (arcade_2d only has
// rectangles/circles/triangles, so the "perspective" is approximated
// with triangles along each side instead of a true trapezoid).
function draw_hallway(list) {
    make_rect(list, SCREEN_WIDTH / 2, SCREEN_HEIGHT / 2, SCREEN_WIDTH, SCREEN_HEIGHT, 30, 28, 34, 255);

    // floor
    make_rect(list, SCREEN_WIDTH / 2, 540, SCREEN_WIDTH, 120, 50, 35, 25, 255);
    for (let plank = 0; plank < 9; plank = plank + 1) {
        make_rect(list, 20 + plank * 90, 540, 4, 120, 35, 24, 16, 255);
    }

    // ceiling shadow band
    make_rect(list, SCREEN_WIDTH / 2, 40, SCREEN_WIDTH, 60, 18, 17, 20, 255);

    // side wall perspective wedges (suggests the hallway narrowing away)
    make_triangle(list, 60, 300, 160, 480, 22, 20, 25, 255);
    make_triangle(list, SCREEN_WIDTH - 60, 300, 160, 480, 22, 20, 25, 255);

    // faint stone seams on the back wall
    for (let row = 0; row < 4; row = row + 1) {
        make_rect(list, SCREEN_WIDTH / 2, 90 + row * 70, SCREEN_WIDTH, 2, 20, 19, 22, 150);
    }

    return undefined;
}

function draw_torch(list, x, y, phase) {
    const bracket = make_rect(list, x, y + 10, 14, 24, 40, 30, 20, 255);
    const glow = make_circle(list, x, y - 34, 40, 255, 150, 50, 70);
    const flame_outer = make_triangle(list, x, y - 32, 16, 26, 255, 120, 30, 255);
    const flame_inner = make_triangle(list, x, y - 38, 9, 14, 255, 210, 90, 255);
    return [flame_outer, flame_inner, glow, phase];
}

function create_fog(list, count) {
    const fog = [];
    for (let i = 0; i < count; i = i + 1) {
        const base_y = 505 + math_random() * 40;
        const start_x = math_random() * SCREEN_WIDTH;
        const speed = 6 + math_random() * 10;
        const width = 160 + math_random() * 140;
        const puff = make_rect(list, start_x, base_y, width, 30, 210, 205, 200, 35);
        fog[i] = [puff, base_y, speed, start_x];
    }
    return fog;
}

function create_light_rays(list, count) {
    const rays = [];
    for (let i = 0; i < count; i = i + 1) {
        const x = 120 + i * (SCREEN_WIDTH - 240) / (count - 1 === 0 ? 1 : count - 1);
        const ray = make_triangle(list, x, 130, 50, 260, 255, 250, 210, 25);
        rays[i] = [ray, x, math_random() * 10];
    }
    return rays;
}

// Small padlock icon: circle "shackle" peeking out from behind a
// rounded body rectangle, plus a tiny keyhole dot.
function draw_lock(list, x, y) {
    const shackle = make_circle(list, x, y - 10, 8, 40, 40, 45, 255);
    const body = make_rect(list, x, y, 22, 18, 210, 175, 60, 255);
    const keyhole = make_circle(list, x, y + 1, 2.5, 40, 30, 15, 255);
    return [shackle, body, keyhole];
}

// Returns a door record:
// [creak_parts, x, y, state, index, frame_box, label_obj, lock_parts,
//  unlocked_glow, status_text]
// state is one of "unlocked" | "locked" | "secret"
function draw_door(list, x, y, state, index, label) {
    const parts = [];
    let n = 0;
    const track_part = (obj, px, py) => {
        parts[n] = [obj, px, py];
        n = n + 1;
        return obj;
    };

    const frame_box = track_part(make_rect(list, x, y, 130, 220, 45, 40, 46, 255), x, y);

    if (state === "secret") {
        // Mostly covered by an old bookshelf/curtain - just barely
        // visible so sharp-eyed players can suspect something's there.
        track_part(make_rect(list, x, y, 116, 200, 40, 30, 24, 255), x, y);
        for (let shelf = 0; shelf < 4; shelf = shelf + 1) {
            track_part(make_rect(list, x, y - 80 + shelf * 55, 110, 8, 25, 18, 14, 255), x, y - 80 + shelf * 55);
        }
        for (let book = 0; book < 6; book = book + 1) {
            const bx = x - 45 + book * 18;
            const bcol_r = 60 + math_random() * 80;
            const bcol_g = 30 + math_random() * 40;
            const bcol_b = 20 + math_random() * 30;
            track_part(make_rect(list, bx, y - 60, 14, 45, bcol_r, bcol_g, bcol_b, 255), bx, y - 60);
        }
    } else {
        track_part(make_rect(list, x, y, 110, 200, 70, 45, 25, 255), x, y);
        track_part(make_rect(list, x, y - 45, 80, 60, 60, 38, 20, 255), x, y - 45);
        track_part(make_rect(list, x, y + 45, 80, 60, 60, 38, 20, 255), x, y + 45);
        track_part(make_circle(list, x + 35, y, 5, 20, 20, 22, 255), x + 35, y);
    }

    const label_obj = make_text(list, x, y + 130, label, 0.75, 230, 220, 200, 255);

    let lock_parts = [];
    if (state === "locked") {
        lock_parts = draw_lock(list, x, y);
        make_text(list, x, y + 150, "LOCKED", 0.6, 220, 90, 80, 255);
    }

    // A soft glow ring that only appears once a door becomes newly
    // unlocked at runtime (see unlock_room2()/sync_room_select_visuals()).
    const unlocked_glow = make_circle(list, x, y, 80, 255, 220, 120, 0);
    // Reusable status line under the label - shows "Unlocked" once a
    // previously-locked door opens, or "Completed (check)" for a
    // finished room. Empty string at creation; content is picked at
    // runtime by choosing which status text object to reveal instead
    // (see room_status_texts below), since text content can't change.
    const status_text = null;

    return [parts, x, y, state, index, frame_box, label_obj, lock_parts, unlocked_glow, status_text];
}

function draw_room_select_doors(list) {
    const y = 320;
    const spacing = 175;
    const start_x = SCREEN_WIDTH / 2 - spacing * 1.5;

    const door1 = draw_door(list, start_x, y, "unlocked", 0, "ROOM 1");
    const door2 = draw_door(list, start_x + spacing, y, "locked", 1, "ROOM 2");
    const door3 = draw_door(list, start_x + spacing * 2, y, "locked", 2, "ROOM 3");
    const door4 = draw_door(list, start_x + spacing * 3, y, "secret", 3, "");

    return [door1, door2, door3, door4];
}

// Pre-made "Unlocked" / "Completed [check]" status labels placed under
// each door, one pair per door index, alpha 0 until that door's state
// changes at runtime (see sync_room_select_visuals()).
let room_status_unlocked_texts = [];
let room_status_completed_texts = [];

function draw_room_status_labels(list, doors) {
    for (let i = 0; i < array_length(doors); i = i + 1) {
        const door = doors[i];
        const x = door[1];
        const y = door[2];
        room_status_unlocked_texts[i] = make_text(list, x, y + 150, "Unlocked", 0.6, 140, 230, 140, 0);
        room_status_completed_texts[i] = make_text(list, x, y + 150, "Completed \u2713", 0.6, 255, 210, 90, 0);
    }
    return undefined;
}

// Big banner shown briefly above Room 2's door the moment it
// becomes unlocked (see unlock_room2() / update_room2_unlock_banner()).
let room2_unlock_banner = null;
let room2_unlock_banner_until = -1;

function draw_room2_unlock_banner(list, doors) {
    const door2 = doors[1];
    room2_unlock_banner = make_text(list, door2[1], door2[2] - 165, "Room 2 Unlocked!", 0.7, 140, 230, 140, 0);
    return undefined;
}

function draw_room_select(list) {
    draw_hallway(list);

    const rays = create_light_rays(list, 3);
    const fog = create_fog(list, 5);
    const dust = create_dust(list, 12, 120, 480);

    const torch_1 = draw_torch(list, 90, 250, 0);
    const torch_2 = draw_torch(list, SCREEN_WIDTH - 90, 250, 2.4);
    const torches = [torch_1, torch_2];

    const doors = draw_room_select_doors(list);
    draw_room_status_labels(list, doors);
    draw_room2_unlock_banner(list, doors);

    make_text(list, SCREEN_WIDTH / 2, 500, "Choose a room  -  A / D or click, Enter to open, ESC to go back", 0.55, 200, 195, 180, 220);

    return [doors, torches, fog, rays, dust];
}

// -- animation ------------------------------------------------------
function animate_hallway(torches, fog, rays, t) {
    for (let i = 0; i < array_length(torches); i = i + 1) {
        const c = torches[i];
        const flame_outer = c[0];
        const flame_inner = c[1];
        const glow = c[2];
        const phase = c[3];

        const flicker = 0.85 + 0.12 * math_sin(t * 10 + phase) + 0.06 * math_sin(t * 21 + phase * 1.5);
        update_scale(flame_outer, [flicker, flicker]);
        update_scale(flame_inner, [flicker * 1.05, flicker * 0.95]);
        update_scale(glow, [0.85 + 0.15 * math_sin(t * 6 + phase), 0.85 + 0.15 * math_sin(t * 6 + phase)]);
    }

    for (let i = 0; i < array_length(fog); i = i + 1) {
        const f = fog[i];
        const puff = f[0];
        const base_y = f[1];
        const speed = f[2];
        const start_x = f[3];
        const x = (start_x + t * speed) % (SCREEN_WIDTH + 200) - 100;
        update_position(puff, [x, base_y]);
    }

    for (let i = 0; i < array_length(rays); i = i + 1) {
        const r = rays[i];
        const ray = r[0];
        const base_x = r[1];
        const phase = r[2];
        const drift = 10 * math_sin(t * 0.2 + phase);
        const alpha = 18 + 12 * math_sin(t * 0.5 + phase);
        update_position(ray, [base_x + drift, 130]);
        update_color(ray, [255, 250, 210, alpha]);
    }

    return undefined;
}

// Pulses the "Room 2 Unlocked!" banner above the hallway door while
// its temporary display window is active, then fades it away.
function update_room2_unlock_banner(loop_count) {
    if (room2_unlock_banner === null) {
        return undefined;
    }
    if (loop_count < room2_unlock_banner_until) {
        const pulse = 200 + 55 * math_sin(loop_count / FPS * 4);
        update_color(room2_unlock_banner, [140, 230, 140, pulse]);
    } else {
        update_color(room2_unlock_banner, [140, 230, 140, 0]);
    }
    return undefined;
}

let deny_flash_until = [-1, -1, -1, -1];

// ---- room-select persistent progress (survives scene switches for
//      the rest of the current game session) -----------------------
// room_completed[i] / room_unlocked[i] mirror the door states shown
// in the hallway. Room 1 starts unlocked+incomplete; the rest start
// locked. Completing room1 flips room_completed[0] and
// room_unlocked[1], which sync_room_select_visuals() then reflects.
let room_completed = [false, false, false, false];
let room_unlocked = [true, false, false, false];

// Set to true the moment Room 2 becomes unlocked, and consumed the
// next time the hallway is (re)entered - that's when the door glow
// flash + "Room 2 Unlocked!" banner actually get triggered, rather
// than firing instantly while the player is still inside Room 1.
let pending_room2_announcement = false;

// ----------------------------------------------------------------
//  complete_room(index) / unlock_room2() - the two helpers that
//  wire the escape room's completion into the hallway's persistent
//  state. Called once, right when the Room 1 door-fade finishes
//  (see update_door_fade()).
// ----------------------------------------------------------------
function complete_room(index) {
    room_completed[index] = true;
    if (index === 0) {
        unlock_room2();
    }
    return undefined;
}

function unlock_room2() {
    room_unlocked[1] = true;
    pending_room2_announcement = true;
    return undefined;
}

// Re-applies room_completed/room_unlocked to the hallway door visuals.
// Called whenever the hallway becomes the active scene again, since
// hide_scene()/show_scene() alone can't change which status label
// or lock icon is showing.
function sync_room_select_visuals(doors) {
    for (let i = 0; i < array_length(doors); i = i + 1) {
        const door = doors[i];
        const lock_parts = door[7];
        const unlocked = room_unlocked[i];
        const completed = room_completed[i];

        for (let p = 0; p < array_length(lock_parts); p = p + 1) {
            // draw_lock() returns raw game objects [shackle, body, keyhole],
            // NOT [obj, x, y] pairs like door creak parts.
            update_color(lock_parts[p], [
                p === 1 ? 210 : 40,
                p === 1 ? 175 : (p === 0 ? 40 : 30),
                p === 1 ? 60 : (p === 0 ? 45 : 15),
                unlocked ? 0 : 255
            ]);
        }

        update_color(room_status_unlocked_texts[i], [140, 230, 140, unlocked && !completed && i !== 0 ? 255 : 0]);
        update_color(room_status_completed_texts[i], [255, 210, 90, completed ? 255 : 0]);
    }
    return undefined;
}

let door_unlock_flash_until = -1;

function animate_door(door, t, loop_count, hovered) {
    const parts = door[0];
    const state = door[3];
    const index = door[4];
    const frame_box = door[5];
    const unlocked_glow = door[8];

    // gentle periodic creak, staggered per door so they never all
    // creak in sync (avoids the "everything moves at once" clutter)
    const period_frames = 7 * FPS;
    const stagger = index * 45;
    const cycle_pos = (loop_count + stagger) % period_frames;
    const creak_frames = math_round(0.4 * FPS);
    const creak = cycle_pos < creak_frames
        ? 0.06 * (1 - cycle_pos / creak_frames) * math_sin(cycle_pos * 3)
        : 0;

    for (let i = 0; i < array_length(parts); i = i + 1) {
        update_rotation(parts[i][0], creak);
    }

    const denied = loop_count < deny_flash_until[index];

    if (denied) {
        const shake = 5 * math_sin(loop_count * 3);
        update_position(frame_box, [door[1] + shake, door[2]]);
        update_color(frame_box, [220, 60, 50, 255]);
    } else if (hovered) {
        update_position(frame_box, [door[1], door[2]]);
        update_color(frame_box, [90, 80, 60, 255]);
    } else {
        update_position(frame_box, [door[1], door[2]]);
        update_color(frame_box, [45, 40, 46, 255]);
    }

    // Freshly-unlocked doors (index 1 right after Room 1 completes)
    // get a brief golden glow pulse so the player notices the change.
    if (index === 1 && loop_count < door_unlock_flash_until) {
        const glow_pulse = 1 + 0.25 * math_sin(t * 6);
        const glow_alpha = 90 + 60 * math_sin(t * 6);
        update_scale(unlocked_glow, [glow_pulse, glow_pulse]);
        update_color(unlocked_glow, [255, 220, 120, glow_alpha]);
    } else if (room_unlocked[index] && index !== 0) {
        const glow_alpha = 35 + 15 * math_sin(t * 2 + index);
        update_scale(unlocked_glow, [1, 1]);
        update_color(unlocked_glow, [255, 220, 120, glow_alpha]);
    } else {
        update_color(unlocked_glow, [255, 220, 120, 0]);
    }

    return undefined;
}

let room_a_prev = false;
let room_d_prev = false;
let room_selected_index = 0;

function update_room_selection_keyboard() {
    const a_down = input_key_down("a") || input_key_down("ArrowLeft");
    const d_down = input_key_down("d") || input_key_down("ArrowRight");

    if (a_down && !room_a_prev) {
        room_selected_index = (room_selected_index + 3) % 4;
    }
    if (d_down && !room_d_prev) {
        room_selected_index = (room_selected_index + 1) % 4;
    }

    room_a_prev = a_down;
    room_d_prev = d_down;
    return undefined;
}

function update_room_selection_mouse(doors) {
    for (let i = 0; i < array_length(doors); i = i + 1) {
        const door = doors[i];
        if (pointer_over_gameobject(door[5])) {
            room_selected_index = door[4];
        }
    }
    return undefined;
}

// Confirms the current selection (Enter/Space, or a direct click on
// a door). Unlocked -> go to Room 1. Locked -> brief red "denied"
// flash. Secret -> stays inert for now (no puzzles/gameplay yet).
function handle_room_selection(doors, confirmed_by_key, clicked, loop_count) {
    let confirmed_index = -1;

    if (confirmed_by_key) {
        confirmed_index = room_selected_index;
    }
    if (clicked) {
        for (let i = 0; i < array_length(doors); i = i + 1) {
            if (pointer_over_gameobject(doors[i][5])) {
                confirmed_index = doors[i][4];
            }
        }
    }

    if (confirmed_index === -1) {
        return undefined;
    }

    const door = doors[confirmed_index];
    const state = door[3];
    // Room 2's door starts life as "locked" visually, but once
    // unlock_room2() flips room_unlocked[1] we still want it to open
    // like an unlocked door rather than flash red.
    const effectively_unlocked = state === "unlocked" || room_unlocked[confirmed_index];

    if (effectively_unlocked) {
        if (confirmed_index === 0) {
            enter_room1();
        } else if (confirmed_index === 1) {
            enter_room2();
        }
        // Room 3 has no scene built yet - unlocking just changes its
        // look for now; entering it is out of scope here.
    } else if (state === "locked") {
        deny_flash_until[confirmed_index] = loop_count + math_round(0.5 * FPS);
    }
    // "secret" does nothing yet - it's just atmosphere for now.

    return undefined;
}

