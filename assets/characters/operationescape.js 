    make_rect(list, SCREEN_WIDTH / 2, SCREEN_HEIGHT / 2, SCREEN_WIDTH, SCREEN_HEIGHT, 60, 58, 62, 255);

    for (let row = 0; row < 5; row = row + 1) {
        make_rect(list, SCREEN_WIDTH / 2, 40 + row * 80, SCREEN_WIDTH, 3, 40, 38, 42, 200);
    }

    for (let col = 0; col < 8; col = col + 1) {
        make_rect(list, 50 + col * 100, 220, 3, 440, 40, 38, 42, 160);
    }

    make_rect(list, SCREEN_WIDTH / 2, 520, SCREEN_WIDTH, 160, 92, 60, 33, 255);

    for (let plank = 0; plank < 7; plank = plank + 1) {
        make_rect(list, 60 + plank * 110, 520, 4, 160, 60, 38, 20, 255);
    }

    return undefined;
}

// Decorative locked door prop behind the title menu (kept from the
// original background scene - not to be confused with the hallway
// doors in the Room Select scene further down).
function draw_landing_door_prop(list) {
    const door_x = SCREEN_WIDTH / 2;
    const door_top = 150;
    const door_height = 300;
    const door_width = 200;
    const door_y = door_top + door_height / 2;

    const parts = [];
    let n = 0;
    const track_part = (obj, x, y) => {
        parts[n] = [obj, x, y];
        n = n + 1;
        return obj;
    };

    track_part(make_rect(list, door_x, door_y, door_width + 30, door_height + 20, 45, 43, 46, 255), door_x, door_y);
    track_part(make_rect(list, door_x, door_y, door_width, door_height, 70, 45, 25, 255), door_x, door_y);
    track_part(make_rect(list, door_x, door_y - 60, door_width - 40, 100, 60, 38, 20, 255), door_x, door_y - 60);
    track_part(make_rect(list, door_x, door_y + 60, door_width - 40, 100, 60, 38, 20, 255), door_x, door_y + 60);

    const brace_1 = make_rect(list, door_x, door_y, door_width - 10, 10, 25, 25, 28, 255);
    update_rotation(brace_1, math_PI / 6);
    track_part(brace_1, door_x, door_y);

    const brace_2 = make_rect(list, door_x, door_y, door_width - 10, 10, 25, 25, 28, 255);
    update_rotation(brace_2, -math_PI / 6);
    track_part(brace_2, door_x, door_y);

    track_part(make_rect(list, door_x, door_y + door_height / 2 - 40, 50, 60, 20, 20, 22, 255),
          door_x, door_y + door_height / 2 - 40);

    track_part(make_circle(list, door_x, door_y + door_height / 2 - 55, 8, 5, 5, 5, 255),
          door_x, door_y + door_height / 2 - 55);
    track_part(make_triangle(list, door_x, door_y + door_height / 2 - 40, 10, 16, 5, 5, 5, 255),
          door_x, door_y + door_height / 2 - 40);

    return parts;
}

