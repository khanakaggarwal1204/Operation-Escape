// Returns [box, glow, text, pin, base_scale, base_tilt, index].
function draw_button(list, label, x, y, index, base_tilt) {
    const glow = make_rect(list, x, y, 270, 80, 255, 200, 90, 0);
    const box = make_rect(list, x, y, 230, 60, 245, 235, 210, 255);
    const text = make_text(list, x, y, label, 1.4, 40, 35, 30, 255);
    const pin = make_circle(list, x, y - 34, 6, 190, 30, 30, 255);

    update_rotation(box, base_tilt);
    update_rotation(text, base_tilt);
    update_rotation(glow, base_tilt);

    return [box, glow, text, pin, 1.4, base_tilt, index];
}

function draw_menu_buttons(list) {
    const play = draw_button(list, "PLAY", SCREEN_WIDTH / 2, 250, 0, -0.05);
    const settings = draw_button(list, "SETTINGS", SCREEN_WIDTH / 2, 330, 1, 0.06);
    const exit_button = draw_button(list, "EXIT", SCREEN_WIDTH / 2, 410, 2, -0.04);
    return [play, settings, exit_button];
}

function draw_magnifier(list) {
    const lens = make_circle(list, 120, 60, 20, 210, 235, 255, 90);
    const rim = make_circle(list, 120, 60, 20, 230, 230, 235, 0);
    const handle = make_rect(list, 120, 60, 10, 30, 90, 70, 40, 255);
    return [lens, rim, handle];
}

function draw_menu(list) {
    draw_dim_backdrop(list);
    draw_corkboard(list);
    const clues = draw_clues(list);
    const title_parts = draw_title(list);
    const buttons = draw_menu_buttons(list);
    const magnifier = draw_magnifier(list);
    return [buttons, title_parts, magnifier, clues];
}

let landing_selected_index = 0;
let key_w_prev = false;
let key_s_prev = false;

const select_sound = create_audio("https://labs.phaser.io/assets/audio/SoundEffects/key.wav", 0.6);

function update_landing_keyboard() {
    const w_down = input_key_down("w");
    const s_down = input_key_down("s");
    const previous = landing_selected_index;

    if (w_down && !key_w_prev) {
        landing_selected_index = (landing_selected_index + 2) % 3;
    }
    if (s_down && !key_s_prev) {
        landing_selected_index = (landing_selected_index + 1) % 3;
    }

    if (landing_selected_index !== previous) {
        play_audio(select_sound);
    }

    key_w_prev = w_down;
    key_s_prev = s_down;
    return undefined;
}

function update_landing_mouse_hover(buttons) {
    for (let i = 0; i < array_length(buttons); i = i + 1) {
        const btn = buttons[i];
        const box = btn[0];
        const index = btn[6];
        if (pointer_over_gameobject(box) && index !== landing_selected_index) {
            landing_selected_index = index;
            play_audio(select_sound);
        }
    }
    return undefined;
}

// Handles Enter/Space confirm AND mouse click confirm for whichever
// button is currently under the pointer. PLAY now leads into the
// Character Selection screen instead of straight into the hallway.
function handle_landing_confirm(buttons, confirmed_by_key, clicked) {
    let confirmed_index = -1;

    if (confirmed_by_key) {
        confirmed_index = landing_selected_index;
    }

    if (clicked) {
        for (let i = 0; i < array_length(buttons); i = i + 1) {
            const box = buttons[i][0];
            if (pointer_over_gameobject(box)) {
                confirmed_index = buttons[i][6];
            }
        }
    }

    if (confirmed_index === 0) {
        change_scene("char_select");
        sync_char_select_visuals();
    }
    // SETTINGS (1) and EXIT (2) have no scene yet - visuals only,
    // exactly like the rest of the menu before this was wired up.
    return undefined;
}

function animate_menu_buttons(buttons, t) {
    for (let i = 0; i < array_length(buttons); i = i + 1) {
        const btn = buttons[i];
        const box = btn[0];
        const glow = btn[1];
        const text = btn[2];
        const pin = btn[3];
        const base_scale = btn[4];
        const base_tilt = btn[5];
        const index = btn[6];

        if (index === landing_selected_index) {
            const pulse = 1 + 0.08 * math_sin(t * 7);
            const straighten = base_tilt * (1 - 0.9);

            update_scale(box, [pulse, pulse]);
            update_scale(text, [base_scale * pulse, base_scale * pulse]);
            update_rotation(box, straighten + 0.03 * math_sin(t * 4));
            update_rotation(text, straighten + 0.03 * math_sin(t * 4));
            update_color(box, [255, 225, 140, 255]);
            update_color(text, [70, 45, 15, 255]);

            const glow_pulse = 1.05 + 0.15 * math_sin(t * 7);
            const glow_alpha = 140 + 70 * math_sin(t * 7);
            update_rotation(glow, straighten);
            update_scale(glow, [glow_pulse, glow_pulse]);
            update_color(glow, [255, 200, 90, glow_alpha]);

            update_scale(pin, [1.3, 1.3]);
            update_color(pin, [255, 60, 60, 255]);
        } else {
            const idle_wobble = base_tilt + 0.02 * math_sin(t * 1.5 + index * 2);

            update_scale(box, [1, 1]);
            update_scale(text, [base_scale, base_scale]);
            update_rotation(box, idle_wobble);
            update_rotation(text, idle_wobble);
            update_color(box, [245, 235, 210, 255]);
            update_color(text, [40, 35, 30, 255]);

            update_rotation(glow, idle_wobble);
            update_scale(glow, [1, 1]);
            update_color(glow, [255, 200, 90, 0]);

            update_scale(pin, [1, 1]);
            update_color(pin, [190, 30, 30, 255]);
        }
    }
    return undefined;
}

function animate_title(title_parts, t) {
    const title = title_parts[0];
    const shadow = title_parts[1];
    const x = title_parts[2];
    const y = title_parts[3];

    const bounce = 6 * math_sin(t * 2.2);
    const wiggle = 0.03 * math_sin(t * 3);
    const r = 200 + 55 * math_sin(t * 1.1);
    const g = 170 + 40 * math_sin(t * 1.1 + 2);
    const b = 70 + 40 * math_sin(t * 1.1 + 4);

    update_position(title, [x, y + bounce]);
    update_rotation(title, wiggle);
    update_color(title, [r, g, b, 255]);

    update_position(shadow, [x + 4, y + 4 + bounce]);
    update_rotation(shadow, wiggle);

    return undefined;
}

function animate_magnifier(magnifier, t) {
    const lens = magnifier[0];
    const rim = magnifier[1];
    const handle = magnifier[2];

    const x = SCREEN_WIDTH / 2 + 320 * math_sin(t * 0.35);
    const y = 55 + 12 * math_sin(t * 0.9);
    const tilt = 0.4 * math_sin(t * 0.7);

    update_position(lens, [x, y]);
    update_position(rim, [x, y]);

    const handle_x = x + 26 * math_cos(tilt);
    const handle_y = y + 26 * math_sin(tilt);
    update_position(handle, [handle_x, handle_y]);
    update_rotation(handle, tilt);
    update_rotation(lens, tilt);
    update_rotation(rim, tilt);

    return undefined;
}

function animate_clues(clues, t) {
    for (let i = 0; i < array_length(clues); i = i + 1) {
        const clue = clues[i];
        const card = clue[0];
        const mark = clue[1];
        const sway = 0.02 * math_sin(t * 1.2 + i * 1.7);
        update_rotation(card, sway);
        update_rotation(mark, sway);
    }
    return undefined;
}

// ================================================================
//  SCENE 1.5: CHARACTER SELECTION - USING SPRITES FROM GITHUB
//  Replaces the procedural drawings with actual PNG images.
//  Characters are displayed at a uniform, larger size (scale 0.6).
// ================================================================

const CHAR_PREVIEW_X = SCREEN_WIDTH / 2;
const CHAR_PREVIEW_Y = 280;

// Character record layout (plain array, named index constants):
const CH_NAME = 0;
const CH_DESC = 1;
const CH_ALL_PARTS = 2;    // [[obj,r,g,b], ...] - every visual part (for whole-character show/hide)
const CH_SHADOW = 3;       // soft shadow obj underneath
const CH_BODY = 4;         // torso/coat obj (breathing)
const CH_HEAD = 5;         // head obj (bob)
const CH_EYE_L = 6;        // left eye (blink)
const CH_EYE_R = 7;        // right eye (blink)
const CH_HAT = 8;          // hat/hood obj (bob with head)
const CH_COAT_FLAPS = 9;   // [[obj,baseX,baseY,baseRot], ...] - coat/hood sway
const CH_ACCESSORIES = 10; // [[obj,baseX,baseY,kind,phase], ...] - accessory animation
const CH_SPRITE = 11;      // sprite object for image-based characters

let characters = [];
let char_select_index = 0;         // currently browsed character while choosing
let selected_character_index = 0;  // confirmed choice, used for the rest of the game

// Base URL for your character images - USING RAW GITHUB URL
const CHAR_IMAGE_BASE = "https://raw.githubusercontent.com/khanakaggarwal1204/Operation-Escape/main/assets/characters/";

// Helper to register a sprite in a scene list (doesn't use color storage)
function reg_sprite(list, sprite) {
    if (list !== undefined) {
        // Store sprite with placeholder color values that won't be used
        list[array_length(list)] = [sprite, 255, 255, 255, 255];
    }
    return sprite;
}

// Helper to create a character sprite
function create_character_sprite(list, imageName, displayName, description) {
    // Create the main sprite
    const sprite = create_sprite(CHAR_IMAGE_BASE + imageName);
    // Scale it to fit the preview area well - UNIFORM LARGER SIZE
    update_scale(sprite, [0.6, 0.6]); // Increased from 0.3 to 0.6
    update_position(sprite, [CHAR_PREVIEW_X, CHAR_PREVIEW_Y]);
    
    // Add to scene list for hiding/showing
    reg_sprite(list, sprite);
    
    // Create a visual record similar to the old system for compatibility
    const record = [];
    record[CH_NAME] = displayName;
    record[CH_DESC] = description;
    record[CH_SPRITE] = sprite;
    // For CH_ALL_PARTS, store the sprite as a special entry
    // Since sprites don't use color, we store the sprite directly
    record[CH_ALL_PARTS] = [[sprite, 255, 255, 255]];
    record[CH_SHADOW] = null;
    record[CH_BODY] = sprite;
    record[CH_HEAD] = sprite;
    record[CH_EYE_L] = null;
    record[CH_EYE_R] = null;
    record[CH_HAT] = sprite;
    record[CH_COAT_FLAPS] = [];
    record[CH_ACCESSORIES] = [];
    
    return record;
}

// ---- Character 1: Classic Detective ----
function create_classic_detective(list) {
    return create_character_sprite(list, "CLASSIC_DETECTIVE.png", "Classic Detective", "A sharp-eyed sleuth with a trusty coat and magnifying glass.");
