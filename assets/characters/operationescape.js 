// ----------------------------------------------------------------
//  TIMELINE - every duration is expressed in seconds and converted
//  to frames via FPS, then chained into cumulative frame boundaries
//  (R2_B01..R2_B25) so the whole intro is a single readable script.
// ----------------------------------------------------------------
const R2_T_TITLE_FADE_IN     = math_round(0.8 * FPS);
const R2_T_TITLE_HOLD        = math_round(3.0 * FPS); // "Hold for 3 seconds"
const R2_T_TITLE_FADE_OUT    = math_round(0.6 * FPS);
const R2_T_LIBRARY_FADE_IN   = math_round(1.0 * FPS); // "Fade into the library"
const R2_T_SCENE1_HOLD       = math_round(4.0 * FPS); // writing + ambient anims
const R2_T_LIGHTNING1        = math_round(0.4 * FPS);
const R2_T_LIGHTNING1_SETTLE = math_round(0.5 * FPS);
const R2_T_DOOR_OPEN         = math_round(2.0 * FPS); // door slowly opens
const R2_T_SHADOW_APPEAR     = math_round(1.5 * FPS);
const R2_T_SHADOW_HOLD       = math_round(1.5 * FPS);
const R2_T_LOOKUP            = math_round(1.0 * FPS); // professor looks up
const R2_T_LIGHTNING2        = math_round(0.3 * FPS);
const R2_T_FADE_NEAR_BLACK   = math_round(0.7 * FPS);
const R2_T_BLACK_HOLD        = math_round(0.6 * FPS);
const R2_T_AFTERMATH_FADE_IN = math_round(1.0 * FPS);
const R2_T_AFTERMATH_HOLD    = math_round(3.0 * FPS);
const R2_T_TEXT1_FADE_IN     = math_round(0.5 * FPS);
const R2_T_TEXT1_HOLD        = math_round(1.5 * FPS);
const R2_T_TEXT1_FADE_OUT    = math_round(0.5 * FPS);
const R2_T_TEXT2_FADE_IN     = math_round(0.5 * FPS);
const R2_T_TEXT2_HOLD        = math_round(1.5 * FPS);
const R2_T_TEXT2_FADE_OUT    = math_round(0.5 * FPS);
const R2_T_FINAL_FADE        = math_round(1.0 * FPS);
const R2_T_FINAL_HOLD        = math_round(0.3 * FPS);
const R2_T_PLAYABLE_FADE_IN  = math_round(1.0 * FPS);

const R2_B01 = R2_T_TITLE_FADE_IN;
const R2_B02 = R2_B01 + R2_T_TITLE_HOLD;
const R2_B03 = R2_B02 + R2_T_TITLE_FADE_OUT;
const R2_B04 = R2_B03 + R2_T_LIBRARY_FADE_IN;
const R2_B05 = R2_B04 + R2_T_SCENE1_HOLD;
const R2_B06 = R2_B05 + R2_T_LIGHTNING1;
const R2_B07 = R2_B06 + R2_T_LIGHTNING1_SETTLE;
const R2_B08 = R2_B07 + R2_T_DOOR_OPEN;
const R2_B09 = R2_B08 + R2_T_SHADOW_APPEAR;
const R2_B10 = R2_B09 + R2_T_SHADOW_HOLD;
const R2_B11 = R2_B10 + R2_T_LOOKUP;
const R2_B12 = R2_B11 + R2_T_LIGHTNING2;
const R2_B13 = R2_B12 + R2_T_FADE_NEAR_BLACK;
const R2_B14 = R2_B13 + R2_T_BLACK_HOLD;
const R2_B15 = R2_B14 + R2_T_AFTERMATH_FADE_IN;
const R2_B16 = R2_B15 + R2_T_AFTERMATH_HOLD;
const R2_B17 = R2_B16 + R2_T_TEXT1_FADE_IN;
const R2_B18 = R2_B17 + R2_T_TEXT1_HOLD;
const R2_B19 = R2_B18 + R2_T_TEXT1_FADE_OUT;
const R2_B20 = R2_B19 + R2_T_TEXT2_FADE_IN;
const R2_B21 = R2_B20 + R2_T_TEXT2_HOLD;
const R2_B22 = R2_B21 + R2_T_TEXT2_FADE_OUT;
const R2_B23 = R2_B22 + R2_T_FINAL_FADE;
const R2_B24 = R2_B23 + R2_T_FINAL_HOLD;
const R2_B25 = R2_B24 + R2_T_PLAYABLE_FADE_IN;

// ---- cinematic state ------------------------------------------
let room2_cinematic_start = -1;
let room2_control_enabled = false;

// ----------------------------------------------------------------
//  Reusable helper functions (as requested): each owns one visual
//  thread of the cinematic and is called every frame from
//  play_room2_intro() with the elapsed frame count / clock.
// ----------------------------------------------------------------
function animate_fireplace(t) {
    const flicker = 0.85 + 0.15 * math_sin(t * 9) + 0.06 * math_sin(t * 23);
    update_scale(room2_fireplace_flame_outer, [flicker, flicker]);
    update_scale(room2_fireplace_flame_inner, [flicker * 1.05, flicker * 0.95]);
    const glow_pulse = 0.85 + 0.15 * math_sin(t * 5);
    update_scale(room2_fireplace_glow, [glow_pulse, glow_pulse]);
    return undefined;
}

function animate_clock(t) {
    update_rotation(room2_clock_pendulum, 0.35 * math_sin(t * 2.4));
    return undefined;
}

function animate_rain(t) {
    for (let i = 0; i < array_length(room2_rain_drops); i = i + 1) {
        const d = room2_rain_drops[i];
        const drop = d[0];
        const base_x = d[1];
        const base_y = d[2];
        const speed = d[3];
        const fall = (t * speed * 8) % 150;
        update_position(drop, [base_x + fall * 0.25, base_y + fall]);
    }
    return undefined;
}

function animate_curtains(t) {
    const sway = 0.06 * math_sin(t * 0.7);
    update_rotation(room2_curtain_l, sway);
    update_rotation(room2_curtain_r, -sway);
    return undefined;
}

function animate_candle_snuff(elapsed, t) {
    const flame_outer = room2_candle[0];
    const flame_inner = room2_candle[1];
    const glow = room2_candle[2];
    const phase = room2_candle[3];
    if (elapsed < R2_B14) {
        const flicker = 0.85 + 0.12 * math_sin(t * 9 + phase);
        update_scale(flame_outer, [flicker, flicker]);
        update_scale(flame_inner, [flicker * 1.05, flicker * 0.95]);
        update_color(flame_outer, [255, 170, 40, 255]);
        update_color(flame_inner, [255, 230, 120, 255]);
        const glow_pulse = 0.85 + 0.15 * math_sin(t * 5 + phase);
        update_scale(glow, [glow_pulse, glow_pulse]);
        update_color(glow, [255, 200, 90, 60]);
    } else {
        // one candle is extinguished after the murder
        update_color(flame_outer, [255, 170, 40, 0]);
        update_color(flame_inner, [255, 230, 120, 0]);
        update_color(glow, [255, 200, 90, 0]);
    }
    return undefined;
}

function animate_professor(elapsed, t) {
    if (elapsed < R2_B10) {
        // normal writing pose, arm wiggling as if scratching out notes
        const wiggle = 4 * math_sin(t * 6);
        update_position(room2_professor_arm, [495, 415 + wiggle]);
        update_position(room2_professor_head, [460, 355]);
    } else if (elapsed >= R2_B10 && elapsed < R2_B12) {
        // the professor looks up, startled
        const p = clamp01((elapsed - R2_B10) / R2_T_LOOKUP);
        update_position(room2_professor_head, [460, 355 - 6 * p]);
    }

    if (elapsed >= R2_B14) {
        // collapsed on the floor beside the toppled chair
        update_rotation(room2_professor_body, math_PI / 2);
        update_position(room2_professor_body, [400, 505]);
        update_rotation(room2_professor_head, math_PI / 2);
        update_position(room2_professor_head, [345, 500]);
        update_rotation(room2_professor_arm, math_PI / 2);
        update_position(room2_professor_arm, [400, 480]);
    }
    return undefined;
}

function animate_chair(elapsed) {
    if (elapsed >= R2_B14) {
        update_rotation(room2_chair, math_PI / 2);
        update_position(room2_chair, [475, 540]);
    }
    return undefined;
}

function animate_desk_disturbance(elapsed) {
    const revealed = elapsed >= R2_B14;
    for (let i = 0; i < array_length(room2_teacup_whole); i = i + 1) {
        update_color(room2_teacup_whole[i], [235, 235, 230, revealed ? 0 : 255]);
    }
    for (let i = 0; i < array_length(room2_teacup_broken); i = i + 1) {
        update_color(room2_teacup_broken[i], [235, 235, 230, revealed ? 255 : 0]);
    }
    update_color(room2_letter_whole, [230, 222, 195, revealed ? 0 : 255]);
    for (let i = 0; i < array_length(room2_letter_torn); i = i + 1) {
        update_color(room2_letter_torn[i], [230, 222, 195, revealed ? 255 : 0]);
    }
    if (revealed) {
        for (let i = 0; i < array_length(room2_papers); i = i + 1) {
            update_rotation(room2_papers[i], 0.6 * math_sin(i * 2.1));
        }
    }
    return undefined;
}

function animate_shadow(elapsed) {
    if (elapsed >= R2_B08 && elapsed < R2_B10) {
        const p = clamp01((elapsed - R2_B08) / R2_T_SHADOW_APPEAR);
        for (let i = 0; i < array_length(room2_shadow_parts); i = i + 1) {
            update_color(room2_shadow_parts[i], [5, 5, 8, 220 * p]);
        }
    } else if (elapsed >= R2_B10 && elapsed < R2_B14) {
        for (let i = 0; i < array_length(room2_shadow_parts); i = i + 1) {
            update_color(room2_shadow_parts[i], [5, 5, 8, 220]);
        }
    } else if (elapsed >= R2_B14) {
        // the figure has vanished by the time the room fades back in
        for (let i = 0; i < array_length(room2_shadow_parts); i = i + 1) {
            update_color(room2_shadow_parts[i], [5, 5, 8, 0]);
        }
    }
    return undefined;
}

function animate_room2_door(elapsed) {
    if (elapsed >= R2_B07 && elapsed < R2_B08) {
        const p = clamp01((elapsed - R2_B07) / R2_T_DOOR_OPEN);
        update_rotation(room2_door, -1.1 * p);
        update_color(room2_door_gap, [8, 6, 10, 220 * p]);
    } else if (elapsed >= R2_B08) {
        update_rotation(room2_door, -1.1);
        update_color(room2_door_gap, [8, 6, 10, 220]);
    }
    return undefined;
}

// lightning_flash() - a brief white wash over the whole screen, with
// a reused sound effect standing in for thunder (no new external
// asset is added - this simply reuses the audio object already
// loaded for the title-screen menu).
function lightning_flash(elapsed) {
    let alpha = 0;
    if (elapsed >= R2_B05 && elapsed < R2_B06) {
        const p = clamp01((elapsed - R2_B05) / R2_T_LIGHTNING1);
        alpha = 220 * math_sin(p * math_PI);
        if (elapsed === R2_B05) { play_audio(select_sound); }
    } else if (elapsed >= R2_B11 && elapsed < R2_B12) {
        const p = clamp01((elapsed - R2_B11) / R2_T_LIGHTNING2);
        alpha = 255 * math_sin(p * math_PI);
        if (elapsed === R2_B11) { play_audio(select_sound); }
    }
    update_color(room2_lightning_rect, [255, 255, 255, alpha]);
    return undefined;
}

// fade_screen() - sets the persistent black overlay's opacity directly.
function fade_screen(alpha) {
    update_color(room2_fade_rect, [0, 0, 0, alpha]);
    return undefined;
}

// update_room2_fade() - drives fade_screen() across the whole
// timeline: black during the title card, clear through most of the
// library scenes, briefly near-black right after the murder, and a
// final fade to black before the playable room fades back in.
function update_room2_fade(elapsed) {
    let alpha = 0;
    if (elapsed < R2_B03) {
        alpha = 255;
    } else if (elapsed < R2_B04) {
        const p = clamp01((elapsed - R2_B03) / R2_T_LIBRARY_FADE_IN);
        alpha = 255 * (1 - p);
    } else if (elapsed < R2_B12) {
        alpha = 0;
    } else if (elapsed < R2_B13) {
        const p = clamp01((elapsed - R2_B12) / R2_T_FADE_NEAR_BLACK);
        alpha = 235 * p; // "fade almost to black", not pure 255
    } else if (elapsed < R2_B14) {
        alpha = 235;
    } else if (elapsed < R2_B15) {
        const p = clamp01((elapsed - R2_B14) / R2_T_AFTERMATH_FADE_IN);
        alpha = 235 * (1 - p);
    } else if (elapsed < R2_B22) {
        alpha = 0;
    } else if (elapsed < R2_B23) {
        const p = clamp01((elapsed - R2_B22) / R2_T_FINAL_FADE);
        alpha = 255 * p;
    } else if (elapsed < R2_B24) {
        alpha = 255;
    } else if (elapsed < R2_B25) {
        const p = clamp01((elapsed - R2_B24) / R2_T_PLAYABLE_FADE_IN);
        alpha = 255 * (1 - p);
    } else {
        alpha = 0;
    }
    fade_screen(alpha);
    return undefined;
}

function animate_room2_titles(elapsed) {
    let title_alpha = 0;
    if (elapsed < R2_B01) {
        title_alpha = 255 * clamp01(elapsed / R2_T_TITLE_FADE_IN);
    } else if (elapsed < R2_B02) {
        title_alpha = 255;
    } else if (elapsed < R2_B03) {
        title_alpha = 255 * (1 - clamp01((elapsed - R2_B02) / R2_T_TITLE_FADE_OUT));
    }
    update_color(room2_title_text, [230, 215, 190, title_alpha]);
    update_color(room2_subtitle_text, [200, 190, 175, title_alpha]);

    let text1_alpha = 0;
    if (elapsed >= R2_B16 && elapsed < R2_B17) {
        text1_alpha = 255 * clamp01((elapsed - R2_B16) / R2_T_TEXT1_FADE_IN);
    } else if (elapsed >= R2_B17 && elapsed < R2_B18) {
        text1_alpha = 255;
    } else if (elapsed >= R2_B18 && elapsed < R2_B19) {
        text1_alpha = 255 * (1 - clamp01((elapsed - R2_B18) / R2_T_TEXT1_FADE_OUT));
    }
    update_color(room2_line1_text, [230, 210, 190, text1_alpha]);

    let text2_alpha = 0;
    if (elapsed >= R2_B19 && elapsed < R2_B20) {
        text2_alpha = 255 * clamp01((elapsed - R2_B19) / R2_T_TEXT2_FADE_IN);
    } else if (elapsed >= R2_B20 && elapsed < R2_B21) {
        text2_alpha = 255;
    } else if (elapsed >= R2_B21 && elapsed < R2_B22) {
        text2_alpha = 255 * (1 - clamp01((elapsed - R2_B21) / R2_T_TEXT2_FADE_OUT));
    }
    update_color(room2_line2_text, [230, 210, 190, text2_alpha]);

    return undefined;
}

// reveal_room2_player() - makes the player avatar visible once the
// cinematic ends and control is handed over.
function reveal_room2_player() {
    // Apply selected character colors to Room 2 player
    const idx = selected_character_index;
    const body_col = CHAR_BODY_COLORS[idx];
    const hat_col = CHAR_HAT_COLORS[idx];
    update_color(room2_player_parts[0][0], [body_col[0], body_col[1], body_col[2], 255]);
    update_color(room2_player_parts[1][0], [210, 180, 150, 255]);
    update_color(room2_player_parts[2][0], [hat_col[0], hat_col[1], hat_col[2], 255]);
    return undefined;
}

// play_room2_intro() - the single per-frame entry point for
// everything cinematic: computes elapsed frames since the cinematic
// began and drives every animate_*/lightning_flash/fade_screen
// helper above from it. Also flips on player control the moment the
// timeline reaches its end.
function play_room2_intro(loop_count, t) {
    const elapsed = loop_count - room2_cinematic_start;

    animate_dust(room2_dust, t);
    animate_room2_titles(elapsed);
    animate_fireplace(t);
    animate_clock(t);
    animate_rain(t);
    animate_curtains(t);
    animate_professor(elapsed, t);
    animate_chair(elapsed);
    animate_candle_snuff(elapsed, t);
    animate_desk_disturbance(elapsed);
    animate_shadow(elapsed);
    animate_room2_door(elapsed);
    lightning_flash(elapsed);
    update_room2_fade(elapsed);

    if (elapsed >= R2_B24 && !room2_control_enabled) {
        room2_control_enabled = true;
        reveal_room2_player();
    }

    return undefined;
}

// transition_to_room2() - resets the cinematic timeline and starts
// it fresh from a black screen ("Fade in from black").
function transition_to_room2() {
    room2_cinematic_start = get_loop_count();
    room2_control_enabled = false;
    update_color(room2_lightning_rect, [255, 255, 255, 0]);
    fade_screen(255);
    return undefined;
}

// enter_room2() - hallway entry point for Room 2's door, mirroring
// enter_room1(): switches scenes, then (re)starts the cinematic.
function enter_room2() {
    change_scene("room2");
    transition_to_room2();
    return undefined;
}

// update_room2_movement() - only ever called once room2_control_enabled
// is true (i.e. after the cinematic finishes). Simple bounds-clamped
// WASD/arrow movement, no collision yet - clue interactions and
// furniture collision are out of scope for this pass.
function update_room2_movement() {
    let dx = 0;
    let dy = 0;
    if (input_key_down("a") || input_key_down("ArrowLeft")) { dx = dx - PLAYER_SPEED; }
    if (input_key_down("d") || input_key_down("ArrowRight")) { dx = dx + PLAYER_SPEED; }
    if (input_key_down("w") || input_key_down("ArrowUp")) { dy = dy - PLAYER_SPEED; }
    if (input_key_down("s") || input_key_down("ArrowDown")) { dy = dy + PLAYER_SPEED; }

    const new_x = room2_player_x + dx;
    if (new_x - PLAYER_RADIUS > ROOM2_MIN_X && new_x + PLAYER_RADIUS < ROOM2_MAX_X) {
        room2_player_x = new_x;
    }
    const new_y = room2_player_y + dy;
    if (new_y - PLAYER_RADIUS > ROOM2_MIN_Y && new_y + PLAYER_RADIUS < ROOM2_MAX_Y) {
        room2_player_y = new_y;
    }

    for (let i = 0; i < array_length(room2_player_parts); i = i + 1) {
        const part = room2_player_parts[i];
        update_position(part[0], [room2_player_x + part[1], room2_player_y + part[2]]);
    }
    return undefined;
}

