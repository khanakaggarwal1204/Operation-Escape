function draw_clue_corner(list, x, y, tilt) {
    const card = make_rect(list, x, y, 70, 55, 235, 228, 205, 255);
    update_rotation(card, tilt);
    const mark = make_text(list, x, y, "?", 1.1, 40, 40, 45, 255);
